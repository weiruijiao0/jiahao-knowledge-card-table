# Fill these paths and hostnames for a NEW, dedicated game site before use.
server {
    listen 443 ssl;
    server_name YOUR_GAME_DOMAIN;
    root /srv/jiahao/dist;
    index index.html;
    ssl_certificate /YOUR_CERTIFICATE/fullchain.pem;
    ssl_certificate_key /YOUR_CERTIFICATE/privkey.pem;
    include mime.types;

    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=600";
    }
    location / {
        try_files $uri $uri/ =404;
    }
}
